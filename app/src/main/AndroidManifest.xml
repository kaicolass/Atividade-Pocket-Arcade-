<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketArcade">

        <!-- Tela 1: Apresentação (tela inicial do app) -->
        <activity
            android:name=".ApresentacaoActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CentralActivity"
            android:exported="false"
            android:parentActivityName=".ApresentacaoActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ScannerActivity"
            android:exported="false"
            android:parentActivityName=".CentralActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ArenaActivity"
            android:exported="false"
            android:parentActivityName=".CentralActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CofreActivity"
            android:exported="false"
            android:parentActivityName=".CentralActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".RandomizadorActivity"
            android:exported="false"
            android:parentActivityName=".CentralActivity"
            android:screenOrientation="portrait" />

    </application>

</manifest>
