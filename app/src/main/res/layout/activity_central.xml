<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espaco_grande">

        <TextView
            android:id="@+id/txtSaudacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/roxo"
            android:textSize="@dimen/texto_titulo"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_subtitulo"
            android:textColor="@color/texto_principal"
            android:textSize="@dimen/texto_subtitulo" />

        <TextView
            android:id="@+id/txtInstrucao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:layout_marginBottom="@dimen/espaco_pequeno"
            android:text="@string/central_instrucao"
            android:textColor="@color/texto_secundario"
            android:textSize="@dimen/texto_corpo" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardScanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_medio"
            app:cardBackgroundColor="@color/branco"
            app:cardCornerRadius="@dimen/raio_card"
            app:cardElevation="@dimen/elevacao_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espaco_medio">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgScanner"
                        android:layout_width="@dimen/tamanho_icone_painel"
                        android:layout_height="@dimen/tamanho_icone_painel"
                        android:background="@drawable/fundo_icone"
                        android:contentDescription="@string/desc_icone_scanner"
                        android:padding="@dimen/padding_icone_painel"
                        android:src="@drawable/ic_scanner" />

                    <TextView
                        android:id="@+id/txtTituloScanner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaco_medio"
                        android:layout_weight="1"
                        android:text="@string/modulo_scanner"
                        android:textColor="@color/texto_principal"
                        android:textSize="@dimen/texto_subtitulo"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtDescricaoScanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_medio"
                    android:lineSpacingExtra="@dimen/espaco_entre_linhas"
                    android:text="@string/descricao_scanner"
                    android:textColor="@color/texto_secundario"
                    android:textSize="@dimen/texto_corpo" />

                <Button
                    android:id="@+id/btnAbrirScanner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    android:text="@string/btn_abrir"
                    android:textSize="@dimen/texto_corpo" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardArena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_medio"
            app:cardBackgroundColor="@color/branco"
            app:cardCornerRadius="@dimen/raio_card"
            app:cardElevation="@dimen/elevacao_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espaco_medio">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgArena"
                        android:layout_width="@dimen/tamanho_icone_painel"
                        android:layout_height="@dimen/tamanho_icone_painel"
                        android:background="@drawable/fundo_icone"
                        android:contentDescription="@string/desc_icone_arena"
                        android:padding="@dimen/padding_icone_painel"
                        android:src="@drawable/ic_arena" />

                    <TextView
                        android:id="@+id/txtTituloArena"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaco_medio"
                        android:layout_weight="1"
                        android:text="@string/modulo_arena"
                        android:textColor="@color/texto_principal"
                        android:textSize="@dimen/texto_subtitulo"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtDescricaoArena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_medio"
                    android:lineSpacingExtra="@dimen/espaco_entre_linhas"
                    android:text="@string/descricao_arena"
                    android:textColor="@color/texto_secundario"
                    android:textSize="@dimen/texto_corpo" />

                <Button
                    android:id="@+id/btnAbrirArena"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    android:text="@string/btn_abrir"
                    android:textSize="@dimen/texto_corpo" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardCofre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_medio"
            app:cardBackgroundColor="@color/branco"
            app:cardCornerRadius="@dimen/raio_card"
            app:cardElevation="@dimen/elevacao_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espaco_medio">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgCofre"
                        android:layout_width="@dimen/tamanho_icone_painel"
                        android:layout_height="@dimen/tamanho_icone_painel"
                        android:background="@drawable/fundo_icone"
                        android:contentDescription="@string/desc_icone_cofre"
                        android:padding="@dimen/padding_icone_painel"
                        android:src="@drawable/ic_cofre" />

                    <TextView
                        android:id="@+id/txtTituloCofre"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaco_medio"
                        android:layout_weight="1"
                        android:text="@string/modulo_cofre"
                        android:textColor="@color/texto_principal"
                        android:textSize="@dimen/texto_subtitulo"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtDescricaoCofre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_medio"
                    android:lineSpacingExtra="@dimen/espaco_entre_linhas"
                    android:text="@string/descricao_cofre"
                    android:textColor="@color/texto_secundario"
                    android:textSize="@dimen/texto_corpo" />

                <Button
                    android:id="@+id/btnAbrirCofre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    android:text="@string/btn_abrir"
                    android:textSize="@dimen/texto_corpo" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardRandomizador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_medio"
            app:cardBackgroundColor="@color/branco"
            app:cardCornerRadius="@dimen/raio_card"
            app:cardElevation="@dimen/elevacao_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espaco_medio">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgRandomizador"
                        android:layout_width="@dimen/tamanho_icone_painel"
                        android:layout_height="@dimen/tamanho_icone_painel"
                        android:background="@drawable/fundo_icone"
                        android:contentDescription="@string/desc_icone_randomizador"
                        android:padding="@dimen/padding_icone_painel"
                        android:src="@drawable/ic_randomizador" />

                    <TextView
                        android:id="@+id/txtTituloRandomizador"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaco_medio"
                        android:layout_weight="1"
                        android:text="@string/modulo_randomizador"
                        android:textColor="@color/texto_principal"
                        android:textSize="@dimen/texto_subtitulo"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtDescricaoRandomizador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_medio"
                    android:lineSpacingExtra="@dimen/espaco_entre_linhas"
                    android:text="@string/descricao_randomizador"
                    android:textColor="@color/texto_secundario"
                    android:textSize="@dimen/texto_corpo" />

                <Button
                    android:id="@+id/btnAbrirRandomizador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    android:text="@string/btn_abrir"
                    android:textSize="@dimen/texto_corpo" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/txtRodape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:gravity="center"
            android:text="@string/central_rodape"
            android:textColor="@color/texto_secundario"
            android:textSize="@dimen/texto_corpo" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
