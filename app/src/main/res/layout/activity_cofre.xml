<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/espaco_grande">

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/modulo_cofre"
            android:textColor="@color/roxo"
            android:textSize="@dimen/texto_titulo"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:text="@string/descricao_cofre"
            android:textColor="@color/texto_secundario"
            android:textSize="@dimen/texto_corpo" />

        <LinearLayout
            android:id="@+id/layoutLegenda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_medio"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtLegendaCerta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/pista_certa"
                android:gravity="center"
                android:padding="@dimen/padding_legenda"
                android:text="@string/cofre_legenda_certa"
                android:textColor="@color/branco"
                android:textSize="@dimen/texto_corpo"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtLegendaOutroLugar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_pequeno"
                android:layout_weight="1"
                android:background="@color/pista_outro_lugar"
                android:gravity="center"
                android:padding="@dimen/padding_legenda"
                android:text="@string/cofre_legenda_outro_lugar"
                android:textColor="@color/texto_principal"
                android:textSize="@dimen/texto_corpo"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtLegendaAusente"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_pequeno"
                android:layout_weight="1"
                android:background="@color/pista_ausente"
                android:gravity="center"
                android:padding="@dimen/padding_legenda"
                android:text="@string/cofre_legenda_ausente"
                android:textColor="@color/branco"
                android:textSize="@dimen/texto_corpo"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtTentativas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:textColor="@color/texto_principal"
            android:textSize="@dimen/texto_corpo"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPalpite"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:hint="@string/hint_palpite">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editPalpite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="4"
                android:maxLines="1"
                android:textSize="@dimen/texto_subtitulo" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnTentar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:text="@string/btn_tentar"
            android:textSize="@dimen/texto_corpo" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardConclusao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_medio"
            android:visibility="gone"
            app:cardBackgroundColor="@color/branco"
            app:cardCornerRadius="@dimen/raio_card"
            app:cardElevation="@dimen/elevacao_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espaco_medio">

                <TextView
                    android:id="@+id/txtConclusaoTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="@dimen/texto_titulo"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtConclusaoDetalhe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    android:gravity="center"
                    android:textColor="@color/texto_principal"
                    android:textSize="@dimen/texto_corpo" />

                <Button
                    android:id="@+id/btnNovaPartida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_medio"
                    android:text="@string/btn_nova_partida"
                    android:textSize="@dimen/texto_corpo" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/txtTituloHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:text="@string/cofre_historico"
            android:textColor="@color/texto_principal"
            android:textSize="@dimen/texto_subtitulo"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHistoricoVazio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:text="@string/cofre_historico_vazio"
            android:textColor="@color/texto_secundario"
            android:textSize="@dimen/texto_corpo" />

        <LinearLayout
            android:id="@+id/layoutHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVoltar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/espaco_pequeno"
                android:layout_weight="1"
                android:text="@string/btn_voltar"
                android:textSize="@dimen/texto_corpo" />

            <Button
                android:id="@+id/btnEncerrarSessao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_pequeno"
                android:layout_weight="1"
                android:text="@string/btn_encerrar_sessao"
                android:textSize="@dimen/texto_corpo" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
