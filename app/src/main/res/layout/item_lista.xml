<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margem_item"
    android:foreground="?attr/selectableItemBackground"
    android:longClickable="true"
    app:cardBackgroundColor="@color/branco"
    app:cardCornerRadius="@dimen/raio_card"
    app:cardElevation="@dimen/elevacao_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espaco_medio">

        <TextView
            android:id="@+id/txtPalavra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_principal"
            android:textSize="@dimen/texto_subtitulo"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:background="@drawable/fundo_icone"
            android:paddingStart="@dimen/espaco_pequeno"
            android:paddingTop="@dimen/margem_item"
            android:paddingEnd="@dimen/espaco_pequeno"
            android:paddingBottom="@dimen/margem_item"
            android:textColor="@color/roxo_escuro"
            android:textSize="@dimen/texto_corpo" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
