<resources>
    <style name="Theme.PocketArcade" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/roxo</item>
        <item name="colorPrimaryVariant">@color/roxo_escuro</item>
        <item name="colorOnPrimary">@color/branco</item>
        <item name="colorSecondary">@color/ambar</item>
        <item name="colorOnSecondary">@color/texto_principal</item>
        <item name="android:colorBackground">@color/fundo</item>
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:statusBarColor">@color/fundo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="textAppearanceButton">@style/TextoBotao</item>
    </style>

    <style name="TextoBotao" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="CelulaTabela">
        <item name="android:padding">@dimen/espaco_pequeno</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">@dimen/texto_corpo</item>
    </style>

    <style name="CelulaTabela.Cabecalho">
        <item name="android:textColor">@color/roxo_escuro</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
